# AI providers
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Local development
DATABASE_URL=sqlite:///./tofan.db
TOFAN_ENV=development
TOFAN_STORAGE_BACKEND=local
TOFAN_UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=20

# Production
# Set TOFAN_ENV=production only with PostgreSQL and S3-compatible object storage.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
TOFAN_S3_BUCKET=
TOFAN_S3_REGION=us-east-1
TOFAN_S3_ENDPOINT_URL=

# WebAuthn/passkeys
# For local development:
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost
# On Render, these can be omitted; the app derives them from
# RENDER_EXTERNAL_HOSTNAME and RENDER_EXTERNAL_URL.

# Optional legacy integrations
TELEGRAM_BOT_TOKEN=
