OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=sqlite:///./tofan.db
MAX_FILE_SIZE_MB=20

# Production
TOFAN_ENV=production
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
TOFAN_UPLOAD_DIR=data/uploads

# Object storage (required in production)
TOFAN_STORAGE_BACKEND=local
TOFAN_S3_BUCKET=
TOFAN_S3_REGION=us-east-1
TOFAN_S3_ENDPOINT_URL=
