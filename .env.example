# TOFAN Smart Academy — deployment environment
# Never commit real secrets to GitHub.

# Application
TOFAN_ENV=development
PORT=8000

# AI providers
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_openai_model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Database
# Development may use SQLite. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./tofan.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Object storage
# Production must use an S3-compatible service: AWS S3, Cloudflare R2, MinIO, etc.
TOFAN_STORAGE_BACKEND=local
TOFAN_UPLOAD_DIR=data/uploads
TOFAN_S3_BUCKET=
TOFAN_S3_REGION=us-east-1
TOFAN_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Uploads
MAX_FILE_SIZE_MB=20

# Authentication
AUTH_OTP_PEPPER=replace_with_a_long_random_secret

# WebAuthn / Passkeys
# Set these to the public HTTPS URL of the deployment.
# Example:
# WEBAUTHN_RP_ID=academy.example.com
# WEBAUTHN_ORIGIN=https://academy.example.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost

# Optional legacy integrations
TELEGRAM_BOT_TOKEN=
