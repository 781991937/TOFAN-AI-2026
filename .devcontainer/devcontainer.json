{
  "name": "TOFAN Smart Academy",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "TOFAN AI Web App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "postStartCommand": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
