  "design_principles": [
    "خطة TOFAN مستقلة وليست نسخة من جامعة أو مؤسسة.",
    "منظمة على أربع سنوات وثمانية فصول.",
    "تجمع بين الرياضيات والإحصاء والبرمجة وإدارة البيانات والتعلم الآلي والتحليل التطبيقي.",
    "كل مادة لها متطلبات سابقة ومخرجات تعلم قابلة للقياس.",
    "قابلة للتحديث مع أدوات ومنهجيات علم البيانات الحديثة."
  ],
  "reference_frameworks": [
    "ACM/IEEE-CS/AAAI data and computing curriculum guidance",
    "NIST data management guidance",
    "CRISP-DM data mining process",
    "ISO/IEC 25012 Data Quality Model"
  ],
