{
  "curriculum_id": "tofan-software-engineering-v1",
  "title_ar": "الخطة الرسمية لتخصص هندسة البرمجيات - أكاديمية طوفان الذكية",
  "version": "1.0",
  "status": "official-draft-for-platform",
  "design_principles": [
    "خطة TOFAN مستقلة وليست نسخة من جامعة أو مؤسسة.",
    "منظمة على أربع سنوات وثمانية فصول لتسهيل المسار الأكاديمي.",
    "تركز على دورة حياة البرمجيات كاملة من المتطلبات إلى التشغيل والصيانة.",
    "كل مادة لها متطلبات سابقة ومخرجات تعلم قابلة للتحقق.",
    "تُحدّث التقنيات والأدوات دوريًا دون تغيير الأساسيات العلمية."
  ],
  "reference_frameworks": [
    "ACM/IEEE Software Engineering curricular guidance",
    "ISO/IEC/IEEE 12207 Software Life Cycle Processes",
    "ISO/IEC/IEEE 29148 Requirements Engineering",
    "ISO/IEC 25010 Software Quality Model",
    "OWASP Secure Software principles",
    "DevOps and CI/CD engineering practices"
  ],
  "structure": "4 years / 8 semesters",
