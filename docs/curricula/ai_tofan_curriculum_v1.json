{
  "curriculum_id": "tofan-ai-v1",
  "title_ar": "الخطة الرسمية لتخصص الذكاء الاصطناعي - أكاديمية طوفان الذكية",
  "version": "1.0",
  "status": "official-draft-for-platform",
  "design_principles": [
    "خطة TOFAN مستقلة وليست نسخة من جامعة أو مؤسسة.",
    "الكليات والتخصصات هي الهيكل الأساسي، والجامعات تستخدم كمراجع مقارنة فقط.",
    "الترتيب مبني على المتطلبات السابقة والكفاءة، لا على الفصل الجامعي وحده.",
    "كل مادة تنتهي بمخرجات تعلم قابلة للتحقق وتطبيق أو تقييم مناسب.",
    "المحتوى العالمي المرجعي يوجه بناء الخطة، مع تحديث دوري للتقنيات الحديثة."
  ],
  "reference_frameworks": [
    "ACM/IEEE-CS/AAAI CS2023 - Artificial Intelligence Knowledge Area",
    "ACM/IEEE-CS/AAAI CS2023 - Algorithmic Foundations",
    "ACM/IEEE-CS/AAAI CS2023 - Mathematical and Statistical Foundations",
