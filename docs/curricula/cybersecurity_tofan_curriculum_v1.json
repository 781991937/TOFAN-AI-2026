{
  "curriculum_id": "tofan-cybersecurity-v1",
  "title_ar": "الخطة الرسمية لتخصص الأمن السيبراني - أكاديمية طوفان الذكية",
  "version": "1.0",
  "status": "official-draft-for-platform",
  "design_principles": [
    "خطة TOFAN مستقلة وليست نسخة من جامعة أو مؤسسة.",
    "الكليات والتخصصات هي الهيكل الأساسي، والجامعات تستخدم كمراجع مقارنة فقط.",
    "الخطة منظمة على أربع سنوات وثمانية فصول لتسهيل المسار الأكاديمي، مع ترتيب المواد وفق المتطلبات السابقة.",
    "المحتوى مبني على أساسيات الأمن السيبراني العالمية مع قابلية التحديث الدوري.",
    "كل مادة تنتهي بمخرجات تعلم قابلة للتحقق وتطبيق أو تقييم مناسب.",
    "المختبرات والتطبيقات العملية جزء أساسي من بناء المهارة، مع الالتزام بالاستخدام القانوني والأخلاقي للبيئات المصرح بها."
  ],
  "reference_frameworks": [
    "ACM/IEEE-CS CSEC2017 - Cybersecurity Curricula Guidelines",
    "NIST NICE Cybersecurity Workforce Framework",
    "NIST Cybersecurity Framework",
    "NIST Secure Software Development Framework (SSDF)",
    "ISO/IEC 27001 information security management principles",
    "OWASP Application Security Verification Standard (ASVS)"
  ],
  "structure": "4 years / 8 semesters",
